# Copy this template to .env for local runs or add these keys in Render / Cloud Run Environment Variables
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_read_write_auth_token

# Super Admin Login Credentials
ADMIN_USERNAME=admin_sushil
ADMIN_PASSWORD=ChangeMeToStrongPassword!
ADMIN_CONTACT_NAME=Sushil
ADMIN_CONTACT_PHONE=+91 98XXXXXXXX
SECRET_KEY=replace_with_random_32_plus_character_secret_key

# Production Public URL (e.g. https://allindiajobs.onrender.com)
SITE_URL=http://localhost:8000

# Optional: Google Search Console verification code
GOOGLE_SITE_VERIFICATION=
